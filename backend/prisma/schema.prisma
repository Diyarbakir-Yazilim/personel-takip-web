// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

// ==========================================
// ENUMS
// ==========================================

enum UserRole {
  STAFF
  SUPERVISOR
  ADMIN
}

enum TaskStatus {
  SCHEDULED
  PENDING
  IN_PROGRESS
  DONE
  MISSED
  FLAGGED
}

enum ScanAction {
  AUTO
  CHECK_IN
  CHECK_OUT
}

enum ScanMethod {
  DYNAMIC_QR
  STATIC_QR
  NFC
  MANUAL_FALLBACK
}

// ==========================================
// MODELS
// ==========================================

model User {
  id         String   @id @default(uuid()) @db.Uuid
  email      String   @unique
  password   String
  fullName   String
  role       UserRole @default(STAFF)
  //deviceId   String?  // DEMO MODE: Device binding disabled
  avatarUrl  String?
  phone      String?
  department String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tasks     TaskInstance[]
  scans     ScanEvent[]
  auditLogs AuditLog[]

  @@map("users")
}

model Building {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  floors Floor[]

  @@map("buildings")
}

model Floor {
  id         String   @id @default(uuid()) @db.Uuid
  buildingId String?  @db.Uuid
  name       String   // e.g., "1st Floor", "Basement"
  level      Int      @default(0) // Floor order (-1, 0, 1, 2 etc.)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  building Building? @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  zones    Zone[]

  
  @@map("floors")
}

model Zone {
  id             String   @id @default(uuid()) @db.Uuid
  floorId        String?  @db.Uuid
  code           String   @unique
  name           String
  minDurationSec Int?   // Minimum required duration in seconds
  maxDurationSec Int?    // Maximum allowed duration in seconds
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  floor Floor?         @relation(fields: [floorId], references: [id], onDelete: SetNull)
  tasks TaskInstance[]

  @@map("zones")
}

model TaskInstance {
  id           String     @id @default(uuid()) @db.Uuid
  zoneId       String     @db.Uuid
  userId       String?    @db.Uuid
  status       TaskStatus @default(SCHEDULED)
  scheduledFor DateTime
  startedAt    DateTime?
  completedAt  DateTime?
  durationSec  Int?
  checklist    String[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  zone  Zone        @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  user  User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  scans ScanEvent[]

  @@index([zoneId])
  @@index([userId])
  @@index([scheduledFor])
  @@index([status])
  @@index([scheduledFor, status])
  @@index([userId, status])
  @@map("task_instances")
}

model ScanEvent {
  id             String  @id @default(uuid()) @db.Uuid
  idempotencyKey String  @unique @db.Uuid
  userId         String  @db.Uuid
  taskId         String? @db.Uuid

  token           String
  requestedAction ScanAction @default(AUTO)
  resolvedAction  ScanAction
  method          ScanMethod

  clientEventId   String   @db.Uuid
  clientScannedAt DateTime
  riskScore       Int      @default(0)
  riskFlags       String[]

  createdAt DateTime @default(now())

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  task            TaskInstance?    @relation(fields: [taskId], references: [id], onDelete: SetNull)
  location        ScanLocation?
  //deviceIntegrity DeviceIntegrity? // DEMO MODE: Disabled

  @@index([userId])
  @@index([taskId])
  @@index([clientScannedAt])
  @@map("scan_events")
}

model ScanLocation {
  id          String @id @default(uuid()) @db.Uuid
  scanEventId String @unique @db.Uuid
  lat         Float
  lng         Float
  accuracy    Float?

  scanEvent ScanEvent @relation(fields: [scanEventId], references: [id], onDelete: Cascade)

  @@map("scan_locations")
}

/* model DeviceIntegrity {
  id             String  @id @default(uuid()) @db.Uuid
  scanEventId    String  @unique @db.Uuid
  isRooted       Boolean @default(false)
  isEmulator     Boolean @default(false)
  isMockLocation Boolean @default(false)

  scanEvent ScanEvent @relation(fields: [scanEventId], references: [id], onDelete: Cascade)

  @@map("device_integrities")
} */

model AuditLog {
  id          String  @id @default(uuid()) @db.Uuid
  userId      String? @db.Uuid
  method      String // HTTP method (POST, PATCH, DELETE, etc.)
  path        String // Request endpoint path
  statusCode  Int // Response HTTP status code
  ip          String? // Client IP address
  userAgent   String? @db.Text
  requestBody String? @db.Text

  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([createdAt])
  @@map("audit_logs")
}
